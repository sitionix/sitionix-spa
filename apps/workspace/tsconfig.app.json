{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@sitionix/ui": ["../../packages/ui/src/index.ts"],
      "@sitionix/ui/*": ["../../packages/ui/src/*"],
      "@sitionix/auth-session": ["../../packages/auth-session/src/index.ts"],
      "@sitionix/auth-session/*": ["../../packages/auth-session/src/*"],
      "@sitionix/http-client": ["../../packages/http-client/src/index.ts"],
      "@sitionix/http-client/*": ["../../packages/http-client/src/*"]
    },

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "skipLibCheck": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,

    "types": ["vite/client"]
  },
  "include": ["src"]
}
