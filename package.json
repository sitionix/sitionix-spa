{
  "name": "sitionix-spa",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @sitionix/ui --filter @apps/shell --filter @apps/auth --filter @apps/workspace dev",
    "build": "pnpm -r build",
    "dev:auth": "pnpm --filter @apps/auth dev",
    "test": "pnpm -r --filter @apps/auth --filter @apps/workspace --filter @apps/shell --filter @apps/builder --filter @sitionix/auth-session --filter @sitionix/ui --filter @packages/tailwind-config test",
    "test:coverage": "pnpm -r --filter @apps/auth --filter @apps/workspace --filter @apps/shell --filter @apps/builder --filter @sitionix/auth-session --filter @sitionix/ui --filter @packages/tailwind-config test:coverage"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "autoprefixer": "^10.4.23",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.3.3"
  }
}
